{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "certificate.schema.json",
  "title": "ExtraProof certificate envelope",
  "type": "object",
  "required": ["schemaVersion", "algorithm", "keyID", "publicKey", "payload", "signature"],
  "properties": {
    "schemaVersion": {
      "const": "extraproof/1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "keyID": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicKey": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 44,
      "maxLength": 44
    },
    "payload": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentMediaType": "application/json",
      "contentSchema": {
        "$ref": "payload.schema.json"
      }
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "additionalProperties": true
}
