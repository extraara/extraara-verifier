{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package.schema.json",
  "type": "object",
  "required": ["schemaVersion", "algorithm", "keyID", "publicKey", "payload", "signature"],
  "properties": {
    "schemaVersion": {
      "const": "extraara-package/0.1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "keyID": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 44,
      "maxLength": 44
    },
    "payload": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 87384
    },
    "signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "additionalProperties": false
}
